{
  "name": "emubox",
  "version": "1.0.0",
  "private": true,
  "description": "EmuBox: Dedicated Console Launcher for Arch Linux (SolidJS 1.9 + Kobalte)",
  "type": "module",
  "scripts": {
    "dev": "vite solid --config solid/vite.config.ts --port 3001 --strictPort",
    "build": "vite build solid --config solid/vite.config.ts",
    "test": "npx tsx tests/vertical-slice.test.ts",
    "start": "node start.js"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.8",
    "@tanstack/solid-virtual": "^3.11.2",
    "@types/animejs": "^3.1.13",
    "animejs": "^4.5.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
