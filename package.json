{
  "name": "emubox",
  "version": "1.0.0",
  "private": true,
  "description": "EmuBox: Dedicated Console Launcher for Arch Linux (SolidJS 1.9 + Kobalte)",
  "type": "module",
  "scripts": {
    "dev": "vite solid --config solid/vite.config.ts --port 3001 --strictPort",
    "build": "vite build solid --config solid/vite.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --import tsx --conditions=browser --test --test-concurrency=4 tests/*.test.ts tests/build-cache.test.mjs tests/telemetry.test.mjs",
    "test:ui": "node --import tsx --conditions=browser --test --test-concurrency=4 tests/library.test.ts tests/catalog-groups.test.ts tests/xmb.test.ts tests/settings.test.ts tests/development-preview.test.ts",
    "test:architecture": "bash tests/architecture.test.sh && bash tests/graphics.test.sh && tsx tests/graphics-policy.test.ts",
    "test:appliance": "node tests/appliance.test.mjs && node tests/appliance-config.test.mjs",
    "check:appliance": "node scripts/check-appliance.mjs",
    "start": "node start.js",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.mjs scripts/verify.mjs package.json tsconfig.json",
    "format": "prettier --write eslint.config.mjs scripts/verify.mjs package.json tsconfig.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --project ./tsconfig.json --noEmit --pretty false",
    "test:validator": "node tests/validator.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:dev": "node scripts/verify.mjs --only tests --only lint --only format --only architecture --only text",
    "mojibake:check": "node scripts/mojibake-check.mjs",
    "quality:text": "npm run mojibake:check",
    "arch:check": "node scripts/architecture-check.mjs && node scripts/docs-check.mjs && node scripts/ipc-contract-check.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.8",
    "@tauri-apps/api": "^2.11.1",
    "animejs": "^4.5.0",
    "lucide-solid": "^1.45.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
