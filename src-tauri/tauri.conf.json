{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emubox",
  "version": "1.0.0",
  "identifier": "org.emubox.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../solid/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EmuBox OS",
        "url": "index.html",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
