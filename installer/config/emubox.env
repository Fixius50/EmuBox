# Compositor & Display
GAMESCOPE_WIDTH=1920
GAMESCOPE_HEIGHT=1080
GAMESCOPE_REFRESH=60
GAMESCOPE_SCALING=integer
GAMESCOPE_HDR=0

# Audio Low-Latency
PIPEWIRE_LATENCY=128/48000
PULSE_LATENCY_MSEC=16

# Logging
EMUBOX_LOG_LEVEL=info
