{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmuBoxBenchmarkResult",
  "type": "object",
  "required": [
    "testRunId",
    "timestamp",
    "framework",
    "frameworkVersion",
    "platform",
    "datasetSize",
    "virtualizationEnabled",
    "spatialNavMode",
    "inputArchitecture",
    "metrics"
  ],
  "properties": {
    "testRunId": { "type": "string" },
    "timestamp": { "type": "string" },
    "framework": { "type": "string" },
    "frameworkVersion": { "type": "string" },
    "platform": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "displayServer": { "type": "string" },
        "webview": { "type": "string" },
        "resolution": { "type": "string" }
      },
      "required": ["os", "displayServer", "webview", "resolution"]
    },
    "datasetSize": { "type": "integer" },
    "virtualizationEnabled": { "type": "boolean" },
    "spatialNavMode": { "type": "string", "enum": ["agnostic", "idiomatic"] },
    "inputArchitecture": { "type": "string", "enum": ["gamepad_api", "tauri_ipc"] },
    "metrics": {
      "type": "object",
      "required": ["startup", "frameStats", "memory", "bundle", "maintainability"],
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "timeToFirstInteractiveMs": { "type": "number" },
            "coldStartMs": { "type": "number" }
          }
        },
        "frameStats": {
          "type": "object",
          "required": [
            "fpsAverage",
            "fps1PercentLow",
            "frameTimeP50Ms",
            "frameTimeP95Ms",
            "frameTimeP99Ms",
            "framesAbove16_67ms",
            "framesAbove33_33ms",
            "framesAbove50ms",
            "totalFramesSampled",
            "durationMs"
          ],
          "properties": {
            "fpsAverage": { "type": "number" },
            "fps1PercentLow": { "type": "number" },
            "frameTimeP50Ms": { "type": "number" },
            "frameTimeP95Ms": { "type": "number" },
            "frameTimeP99Ms": { "type": "number" },
            "framesAbove16_67ms": { "type": "integer" },
            "framesAbove33_33ms": { "type": "integer" },
            "framesAbove50ms": { "type": "integer" },
            "totalFramesSampled": { "type": "integer" },
            "durationMs": { "type": "number" }
          }
        },
        "memory": {
          "type": "object",
          "required": ["osProcessRssMb", "osPrivateWorkingSetMb", "jsHeapUsedMb"],
          "properties": {
            "osProcessRssMb": { "type": "number" },
            "osPrivateWorkingSetMb": { "type": "number" },
            "jsHeapUsedMb": { "type": "number" }
          }
        },
        "bundle": {
          "type": "object",
          "required": [
            "jsRawKb",
            "jsGzipKb",
            "cssRawKb",
            "cssGzipKb",
            "tauriStandaloneBinaryMb",
            "installerPackageMb",
            "totalInstalledFootprintMb"
          ],
          "properties": {
            "jsRawKb": { "type": "number" },
            "jsGzipKb": { "type": "number" },
            "jsBrotliKb": { "type": "number" },
            "cssRawKb": { "type": "number" },
            "cssGzipKb": { "type": "number" },
            "cssBrotliKb": { "type": "number" },
            "tauriStandaloneBinaryMb": { "type": "number" },
            "installerPackageMb": { "type": "number" },
            "totalInstalledFootprintMb": { "type": "number" }
          }
        },
        "maintainability": {
          "type": "object",
          "required": [
            "linesOfCode",
            "fileCount",
            "cyclomaticComplexityScore",
            "extensionTestLocAdded",
            "extensionTestFrictionNotes"
          ],
          "properties": {
            "linesOfCode": { "type": "integer" },
            "fileCount": { "type": "integer" },
            "cyclomaticComplexityScore": { "type": "number" },
            "extensionTestLocAdded": { "type": "integer" },
            "extensionTestFrictionNotes": { "type": "string" }
          }
        }
      }
    }
  }
}
